// cuursor UI: tray flyout and settings window (Fluent style, follows the
// Windows light/dark theme).

import { Switch, Button, ComboBox, LineEdit, Palette, ScrollView, ProgressIndicator } from "std-widgets.slint";

export struct MonitorTile {
    x: length,
    y: length,
    w: length,
    h: length,
    title: string,
    subtitle: string,
    primary: bool,
    warn: bool,
}

export struct MonitorRow {
    name: string,
    detail: string,
    diagonal: string,
    hint: string,
    warn: bool,
}

export global Strings {
    in property <string> app: "cuursor";
    in property <string> on: "On";
    in property <string> off: "Off";
    in property <string> smooth: "Seamless cursor";
    in property <string> smooth-desc: "No jumps or sticking at screen edges";
    in property <string> settings: "Settings";
    in property <string> size-warning: "A monitor size is unknown. Set it in Settings.";
    in property <string> settings-title: "Settings";
    in property <string> window-title: "cuursor settings";
    in property <string> general: "General";
    in property <string> enabled: "Enabled";
    in property <string> enabled-desc: "Fix cursor movement between monitors";
    in property <string> autostart: "Start with Windows";
    in property <string> crossing: "Cursor crossing";
    in property <string> mode: "Method";
    in property <[string]> modes: ["By physical size", "Stretch edge to edge"];
    in property <string> align: "Monitor alignment";
    in property <string> align-desc: "How the screens stand on your desk";
    in property <[string]> aligns: ["As in Display settings", "Top edges", "Centers", "Bottom edges"];
    in property <string> monitors: "Monitors";
    in property <string> diagonal-desc: "Diagonal, inches";
}

// Monitors drawn to scale, in the arrangement from Display settings.
component MonitorMap inherits Rectangle {
    in property <[MonitorTile]> tiles;
    for t in tiles: Rectangle {
        x: t.x;
        y: t.y;
        width: t.w;
        height: t.h;
        border-radius: 6px;
        border-width: t.primary ? 2px : 1px;
        border-color: t.warn ? #d83b01 : (t.primary ? Palette.accent-background : Palette.border.with-alpha(0.5));
        background: Palette.alternate-background;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: t.title;
                horizontal-alignment: center;
                font-size: 15px;
                font-weight: 600;
                color: Palette.foreground;
            }
            Text {
                text: t.subtitle;
                horizontal-alignment: center;
                font-size: 11px;
                color: Palette.foreground.with-alpha(0.65);
            }
        }
    }
}

component Card inherits Rectangle {
    background: Palette.alternate-background;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.border.with-alpha(0.18);
}

component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    padding: 14px;
    spacing: 12px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: root.title;
            font-size: 14px;
            color: Palette.foreground;
            overflow: elide;
        }
        if root.description != "": Text {
            text: root.description;
            font-size: 12px;
            color: Palette.foreground.with-alpha(0.65);
            overflow: elide;
        }
    }
    @children
}

component SectionTitle inherits Text {
    font-size: 14px;
    font-weight: 600;
    color: Palette.foreground;
}

export component Flyout inherits Window {
    in property <[MonitorTile]> tiles;
    in-out property <bool> enabled;
    in property <bool> size-warning;
    callback toggled(bool);
    callback open-settings();
    callback dismiss();

    title: Strings.app;
    icon: @image-url("../assets/icon.png");
    no-frame: true;
    always-on-top: true;
    width: 360px;
    height: 350px;
    background: Palette.background;

    Rectangle {
        border-width: 1px;
        border-color: Palette.border.with-alpha(0.5);
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 8px;
                Image {
                    source: @image-url("../assets/icon.png");
                    width: 22px;
                    height: 22px;
                }
                Text {
                    text: Strings.app;
                    font-size: 15px;
                    font-weight: 600;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }
                Rectangle { }
                Text {
                    text: root.enabled ? Strings.on : Strings.off;
                    vertical-alignment: center;
                    font-size: 12px;
                    color: root.enabled ? Palette.accent-background : Palette.foreground.with-alpha(0.6);
                }
            }

            Card {
                height: 116px;
                MonitorMap {
                    tiles: root.tiles;
                    width: parent.width;
                    height: parent.height;
                }
            }

            Card {
                SettingRow {
                    title: Strings.smooth;
                    description: Strings.smooth-desc;
                    Switch {
                        checked <=> root.enabled;
                        toggled => {
                            root.toggled(self.checked);
                        }
                    }
                }
            }

            if root.size-warning: Text {
                text: Strings.size-warning;
                font-size: 12px;
                color: #d83b01;
                wrap: word-wrap;
            }

            Rectangle { }

            HorizontalLayout {
                alignment: end;
                Button {
                    text: Strings.settings;
                    clicked => {
                        root.open-settings();
                    }
                }
            }
        }
    }
}

export component Settings inherits Window {
    in property <[MonitorTile]> tiles;
    in property <[MonitorRow]> monitors;
    in-out property <bool> enabled;
    in-out property <bool> autostart;
    in-out property <int> mode;
    in-out property <int> align;
    callback enabled-toggled(bool);
    callback autostart-toggled(bool);
    callback mode-selected(int);
    callback align-selected(int);
    callback diagonal-edited(int, string);

    title: Strings.window-title;
    icon: @image-url("../assets/icon.png");
    preferred-width: 520px;
    preferred-height: 680px;
    min-width: 420px;
    min-height: 420px;
    background: Palette.background;

    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: 10px;
            alignment: start;

            Text {
                text: Strings.settings-title;
                font-size: 26px;
                font-weight: 600;
                color: Palette.foreground;
            }

            Card {
                height: 160px;
                MonitorMap {
                    tiles: root.tiles;
                    width: parent.width;
                    height: parent.height;
                }
            }

            SectionTitle {
                text: Strings.general;
            }

            Card {
                VerticalLayout {
                    SettingRow {
                        title: Strings.enabled;
                        description: Strings.enabled-desc;
                        Switch {
                            checked <=> root.enabled;
                            toggled => {
                                root.enabled-toggled(self.checked);
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Palette.border.with-alpha(0.15);
                    }

                    SettingRow {
                        title: Strings.autostart;
                        Switch {
                            checked <=> root.autostart;
                            toggled => {
                                root.autostart-toggled(self.checked);
                            }
                        }
                    }
                }
            }

            SectionTitle {
                text: Strings.crossing;
            }

            Card {
                VerticalLayout {
                    SettingRow {
                        title: Strings.mode;
                        ComboBox {
                            width: 230px;
                            model: Strings.modes;
                            current-index <=> root.mode;
                            selected => {
                                root.mode-selected(self.current-index);
                            }
                        }
                    }

                    if root.mode == 0: Rectangle {
                        height: 1px;
                        background: Palette.border.with-alpha(0.15);
                    }

                    if root.mode == 0: SettingRow {
                        title: Strings.align;
                        description: Strings.align-desc;
                        ComboBox {
                            width: 230px;
                            model: Strings.aligns;
                            current-index <=> root.align;
                            selected => {
                                root.align-selected(self.current-index);
                            }
                        }
                    }
                }
            }

            SectionTitle {
                text: Strings.monitors;
            }

            for m[i] in root.monitors: Card {
                SettingRow {
                    title: m.name;
                    description: m.detail;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        LineEdit {
                            width: 90px;
                            text: m.diagonal;
                            placeholder-text: "24";
                            horizontal-alignment: right;
                            edited(value) => {
                                root.diagonal-edited(i, value);
                            }
                        }
                        Text {
                            text: m.hint;
                            font-size: 11px;
                            horizontal-alignment: right;
                            color: m.warn ? #d83b01 : Palette.foreground.with-alpha(0.6);
                        }
                    }
                }
            }
        }
    }
}

export global SetupStrings {
    in property <string> tagline: "Seamless cursor movement between monitors of different size";
    in property <string> install: "Install";
    in property <string> update: "Update";
    in property <string> installing: "Installing…";
    in property <string> done: "cuursor is installed";
    in property <string> done-desc: "It is running in the system tray and will start with Windows.";
    in property <string> open: "Open settings";
    in property <string> close: "Close";
    in property <string> failed: "Installation failed";
    in property <string> retry: "Try again";
    in property <string> uninstall-q: "Remove cuursor?";
    in property <string> uninstall-desc: "The app and its settings will be removed from this computer.";
    in property <string> uninstall: "Remove";
    in property <string> cancel: "Cancel";
    in property <string> uninstalling: "Removing…";
    in property <string> uninstalled: "cuursor has been removed";
}

// Shared frame of the setup and uninstall windows: icon, title, text, and
// a button row at the bottom.
component SetupPage inherits VerticalLayout {
    in property <string> heading;
    in property <string> text;
    in property <bool> busy;
    in property <bool> success;
    in property <bool> error;
    padding: 32px;
    spacing: 0px;

    Rectangle {
        height: 84px;
        Image {
            x: 0;
            source: @image-url("../assets/icon.png");
            width: 72px;
            height: 72px;
            opacity: root.busy ? 0.6 : 1.0;
        }
        if root.success: Rectangle {
            x: 50px;
            y: 50px;
            width: 26px;
            height: 26px;
            border-radius: 13px;
            background: #0f7b0f;
            border-width: 2px;
            border-color: Palette.background;
            Text {
                text: "✓";
                color: white;
                font-size: 15px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    Rectangle { height: 16px; }
    Text {
        text: root.heading;
        font-size: 28px;
        font-weight: 600;
        color: root.error ? #c42b1c : Palette.foreground;
        wrap: word-wrap;
    }
    Rectangle { height: 8px; }
    Text {
        text: root.text;
        font-size: 14px;
        color: Palette.foreground.with-alpha(0.7);
        wrap: word-wrap;
    }
    Rectangle { vertical-stretch: 1; }
    if root.busy: ProgressIndicator {
        indeterminate: true;
        height: 4px;
    }
    if root.busy: Rectangle { height: 26px; }
    @children
}

export component Setup inherits Window {
    // 0 welcome, 1 installing, 2 done, 3 error
    in-out property <int> page;
    in property <string> version;
    in property <string> details;
    in property <bool> is-update;
    in property <string> error-text;
    callback install();
    callback open-settings();
    callback dismiss();

    title: "cuursor";
    icon: @image-url("../assets/icon.png");
    width: 540px;
    height: 380px;
    background: Palette.background;

    SetupPage {
        heading: root.page == 0 ? "cuursor " + root.version
            : root.page == 1 ? SetupStrings.installing
            : root.page == 2 ? SetupStrings.done
            : SetupStrings.failed;
        text: root.page == 0 ? SetupStrings.tagline
            : root.page == 2 ? SetupStrings.done-desc
            : root.page == 3 ? root.error-text
            : "";
        busy: root.page == 1;
        success: root.page == 2;
        error: root.page == 3;

        if root.page == 0: Text {
            text: root.details;
            font-size: 12px;
            color: Palette.foreground.with-alpha(0.5);
        }
        if root.page == 0: Rectangle { height: 16px; }

        if root.page != 1: HorizontalLayout {
            alignment: end;
            spacing: 8px;
            if root.page == 0 || root.page == 3: Button {
                text: root.page == 3 ? SetupStrings.retry : (root.is-update ? SetupStrings.update : SetupStrings.install);
                primary: true;
                min-width: 140px;
                clicked => {
                    root.install();
                }
            }
            if root.page == 2: Button {
                text: SetupStrings.open;
                min-width: 140px;
                clicked => {
                    root.open-settings();
                }
            }
            if root.page == 2: Button {
                text: SetupStrings.close;
                primary: true;
                min-width: 100px;
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}

export component Uninstall inherits Window {
    // 0 confirm, 1 removing, 2 done, 3 error
    in-out property <int> page;
    in property <string> error-text;
    callback uninstall();
    callback dismiss();

    title: "cuursor";
    icon: @image-url("../assets/icon.png");
    width: 540px;
    height: 380px;
    background: Palette.background;

    SetupPage {
        heading: root.page == 0 ? SetupStrings.uninstall-q
            : root.page == 1 ? SetupStrings.uninstalling
            : root.page == 2 ? SetupStrings.uninstalled
            : SetupStrings.failed;
        text: root.page == 0 ? SetupStrings.uninstall-desc : root.page == 3 ? root.error-text : "";
        busy: root.page == 1;
        success: root.page == 2;
        error: root.page == 3;

        if root.page != 1: HorizontalLayout {
            alignment: end;
            spacing: 8px;
            if root.page == 0: Button {
                text: SetupStrings.cancel;
                min-width: 100px;
                clicked => {
                    root.dismiss();
                }
            }
            if root.page == 0: Button {
                text: SetupStrings.uninstall;
                primary: true;
                min-width: 120px;
                clicked => {
                    root.uninstall();
                }
            }
            if root.page >= 2: Button {
                text: SetupStrings.close;
                primary: true;
                min-width: 100px;
                clicked => {
                    root.dismiss();
                }
            }
        }
    }
}
